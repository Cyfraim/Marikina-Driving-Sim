# ---------------------------------------------------------------------------
# Google Maps Static API key para sa satellite minimap (Step 4)
#
# Paano gamitin:
# 1. Kumuha ng key sa https://console.cloud.google.com/
#    -> Enable "Maps Static API"
# 2. I-paste ang key sa .env (hindi i-commit ang .env)
# 3. I-restart: npm run dev
#
# Walang key? Okay lang - mag-fallback sa vector minimap mula sa
# roadData.js (tunay pa rin ang kalsada, satellite lang ang nawawala).
# ---------------------------------------------------------------------------
GOOGLE_MAPS_API_KEY=your_key_here
